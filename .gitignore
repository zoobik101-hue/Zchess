# ==========================================
# ZChess - Git Ignore (GitHub = static site only)
# ==========================================

# Secrets - NEVER commit
github-token.txt
*.token
.env
.env.*
secrets.txt

# Local deploy tool (stays on your PC only)
push-github.bat

# Cursor / IDE (not part of the site)
.cursor/

# Dev scripts (run locally before push, not served)
scripts/

# Firebase rules (publish in Firebase Console, not GitHub Pages)
firestore.rules

# Unused duplicate worker (logic is inlined in chess-board.js)
js/ai-worker.js

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Node (if used locally)
node_modules/
