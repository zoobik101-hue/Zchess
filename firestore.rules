rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles + leaderboard (public read for rating page and username check on register)
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Who is online now
    match /presence/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Unique usernames (reserved at registration)
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Multiplayer rooms (your rules - kept as in Firebase console)
    match /rooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.white.uid == request.auth.uid;

      allow update: if request.auth != null && (
        resource.data.white.uid == request.auth.uid
        || (resource.data.black != null
            && resource.data.black.uid == request.auth.uid)
        || (resource.data.status == 'waiting'
            && resource.data.black == null
            && request.resource.data.black.uid == request.auth.uid)
      );

      allow delete: if false;
    }
  }
}
